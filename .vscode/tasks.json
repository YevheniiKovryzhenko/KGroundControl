{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure active preset",
            "type": "cmake",
            "command": "configure",
            "preset": "${command:cmake.activeConfigurePresetName}",
            "problemMatcher": []
        },
        {
            "label": "CMake: build active preset",
            "type": "cmake",
            "command": "build",
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "CMake: configure and build active preset",
            "dependsOn": [
                "CMake: configure active preset",
                "CMake: build active preset"
            ],
            "dependsOrder": "sequence"
        }
    ]
}
