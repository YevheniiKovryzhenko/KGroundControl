cmake_minimum_required(VERSION 3.22)
if(DEFINED DEPLOYMENT_INPUT)
    include("${DEPLOYMENT_INPUT}")
endif()
if(NOT CONFIG STREQUAL "Release" AND NOT CONFIG STREQUAL "MinSizeRel")
    message(STATUS "PackageDist: no deployment for '${CONFIG}'")
    return()
endif()
foreach(required TARGET_FILE DEST_DIR VERSIONED_BINARY_NAME PROJECT_SOURCE_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "PackageDist: missing ${required}")
    endif()
endforeach()
if(NOT EXISTS "${TARGET_FILE}")
    message(FATAL_ERROR "PackageDist: executable does not exist: ${TARGET_FILE}")
endif()
# Serialize packages sharing a destination. Build entirely in a new directory so
# a failure cannot damage the last successfully deployed version.
get_filename_component(_parent "${DEST_DIR}" DIRECTORY)
file(MAKE_DIRECTORY "${_parent}")
file(LOCK "${DEST_DIR}.lock" GUARD PROCESS TIMEOUT 60)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _id)
set(_stage "${DEST_DIR}.stage-${_id}")
file(MAKE_DIRECTORY "${_stage}")
function(deployment_fail reason)
    file(REMOVE_RECURSE "${_stage}")
    message(FATAL_ERROR "PackageDist: ${reason}")
endfunction()
set(_executable "${_stage}/${VERSIONED_BINARY_NAME}")
if(IS_APPLE)
    if(NOT IS_DIRECTORY "${APP_BUNDLE_DIR}")
        deployment_fail("Application bundle is missing: ${APP_BUNDLE_DIR}")
    endif()
    get_filename_component(_bundle_name "${APP_BUNDLE_DIR}" NAME)
    get_filename_component(_binary_name "${TARGET_FILE}" NAME)
    file(COPY "${APP_BUNDLE_DIR}" DESTINATION "${_stage}")
    file(RENAME "${_stage}/${_bundle_name}" "${_stage}/${VERSIONED_BINARY_NAME}.app")
    set(_executable "${_stage}/${VERSIONED_BINARY_NAME}.app/Contents/MacOS/${_binary_name}")
else()
    file(COPY_FILE "${TARGET_FILE}" "${_executable}")
endif()
file(CHMOD "${_executable}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
    GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)

if(IS_WINDOWS)
    if(NOT IS_STATIC)
        if(NOT EXISTS "${WINDEPLOYQT_EXECUTABLE}")
            deployment_fail("Shared Qt requires windeployqt from the selected SDK")
        endif()
        execute_process(COMMAND "${WINDEPLOYQT_EXECUTABLE}" --release
            --dir "${_stage}" "${_executable}" RESULT_VARIABLE _result
            OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
        if(NOT _result EQUAL 0)
            deployment_fail("windeployqt failed: ${_out}\n${_err}")
        endif()
    endif()
    # Static Qt may still use the dynamic MSVC runtime (/MD).
    foreach(runtime IN LISTS SYSTEM_RUNTIME_LIBRARIES)
        if(NOT EXISTS "${runtime}")
            deployment_fail("Missing compiler runtime: ${runtime}")
        endif()
        file(COPY "${runtime}" DESTINATION "${_stage}")
    endforeach()
elseif(NOT IS_APPLE)
    if(STRIP_DEPLOYMENT)
        if(NOT EXISTS "${STRIP_EXECUTABLE}")
            deployment_fail("strip tool unavailable; set KGC_STRIP_DEPLOYMENT=OFF to retain symbols")
        endif()
        execute_process(COMMAND "${STRIP_EXECUTABLE}" --strip-unneeded "${_executable}"
            RESULT_VARIABLE _result ERROR_VARIABLE _err)
        if(NOT _result EQUAL 0)
            deployment_fail("strip failed: ${_err}")
        endif()
    endif()
    # Record runtime dependencies; don't bundle glibc or arbitrary host libraries.
    # Linux packages target a compatible distribution, rather than every Linux host.
    find_program(_ldd NAMES ldd)
    if(NOT _ldd)
        deployment_fail("ldd is required to validate native Linux deployment dependencies")
    endif()
    execute_process(COMMAND "${_ldd}" "${_executable}" RESULT_VARIABLE _result
        OUTPUT_VARIABLE _deps ERROR_VARIABLE _err)
    if(NOT _result EQUAL 0 OR _deps MATCHES "not found")
        deployment_fail("Unresolved runtime libraries: ${_deps}\n${_err}")
    endif()
    file(WRITE "${_stage}/runtime-dependencies.txt" "${_deps}\nOpenSSL backend: compatible libssl/libcrypto must be installed (loaded at runtime).\nOpenGL drivers and optional SDL backends may also be loaded at runtime.\n")
endif()
if(IS_WINDOWS AND NOT IS_MSVC AND STRIP_DEPLOYMENT)
    if(NOT EXISTS "${STRIP_EXECUTABLE}")
        deployment_fail("MinGW strip tool unavailable")
    endif()
    execute_process(COMMAND "${STRIP_EXECUTABLE}" --strip-unneeded "${_executable}"
        RESULT_VARIABLE _result ERROR_VARIABLE _err)
    if(NOT _result EQUAL 0)
        deployment_fail("strip failed: ${_err}")
    endif()
endif()
foreach(runtime IN LISTS EXTRA_RUNTIME_FILES)
    if(NOT EXISTS "${runtime}" OR IS_DIRECTORY "${runtime}")
        deployment_fail("Additional runtime file is missing or not a file: ${runtime}")
    endif()
    file(COPY "${runtime}" DESTINATION "${_stage}")
endforeach()
foreach(doc README.md LICENSE)
    if(EXISTS "${PROJECT_SOURCE_DIR}/${doc}")
        file(COPY "${PROJECT_SOURCE_DIR}/${doc}" DESTINATION "${_stage}")
    endif()
endforeach()
file(SIZE "${_executable}" _bytes)
file(WRITE "${_stage}/build-info.txt" "${BUILD_DESCRIPTION}\nExecutable bytes: ${_bytes}\nLinux system dependencies are not bundled. Shared Linux Qt also requires the matching Qt runtime and plugins.\nWindows packages include redistributable compiler runtime files when available; OpenSSL runtime DLLs may still be required.\n")
# Hash all shipped files, including plugins/DLLs, relative to the package root.
file(GLOB_RECURSE _files RELATIVE "${_stage}" LIST_DIRECTORIES FALSE "${_stage}/*")
list(SORT _files)
set(_checksums "")
foreach(item IN LISTS _files)
    file(SHA256 "${_stage}/${item}" _sha)
    string(APPEND _checksums "${_sha}  ${item}\n")
endforeach()
file(WRITE "${_stage}/SHA256SUMS" "${_checksums}")
set(_backup "${DEST_DIR}.previous-${_id}")
if(EXISTS "${DEST_DIR}")
    file(RENAME "${DEST_DIR}" "${_backup}" RESULT _result)
    if(NOT _result STREQUAL "0")
        deployment_fail("Cannot move existing deployment aside: ${_result}")
    endif()
endif()
file(RENAME "${_stage}" "${DEST_DIR}" RESULT _result)
if(NOT _result STREQUAL "0")
    if(EXISTS "${_backup}")
        file(RENAME "${_backup}" "${DEST_DIR}")
    endif()
    deployment_fail("Cannot publish completed deployment: ${_result}")
endif()
file(REMOVE_RECURSE "${_backup}")
message(STATUS "PackageDist: ${CONFIG}, ${_bytes} executable bytes: ${DEST_DIR}")
