# Honor explicit SDK selection before trying standard native installation layouts.
set(QT_TARGET_VERSION "" CACHE STRING "Qt version for automatic discovery (empty: newest installed)")
if(NOT CMAKE_PREFIX_PATH AND
   NOT Qt6_DIR AND NOT Qt5_DIR AND NOT QT_DIR AND NOT CMAKE_TOOLCHAIN_FILE)
    set(_qt_candidates "$ENV{QTDIR}")
    # ROS and other SDKs also populate this variable; only prioritize entries
    # containing a Qt package, rather than disabling Qt discovery altogether.
    file(TO_CMAKE_PATH "$ENV{CMAKE_PREFIX_PATH}" _qt_env_prefixes)
    list(APPEND _qt_candidates ${_qt_env_prefixes})
    if(WIN32)
        # These presets use MSVC. Never automatically select an incompatible MinGW SDK.
        set(_qt_roots "C:/Qt" "D:/Qt" "$ENV{USERPROFILE}/Qt")
    else()
        set(_qt_roots "$ENV{HOME}/Qt")
    endif()
    foreach(_kind Static Shared)
        foreach(_root IN LISTS _qt_roots)
            if(QT_TARGET_VERSION)
                list(APPEND _qt_candidates "${_root}/${_kind}/v${QT_TARGET_VERSION}/install")
            else()
                file(GLOB _qt_versions LIST_DIRECTORIES TRUE "${_root}/${_kind}/v6.*")
                list(SORT _qt_versions COMPARE NATURAL ORDER DESCENDING)
                foreach(_version IN LISTS _qt_versions)
                    list(APPEND _qt_candidates "${_version}/install")
                endforeach()
            endif()
        endforeach()
        if(WIN32)
            if(QT_TARGET_VERSION)
                list(APPEND _qt_candidates "C:/Qt_${_kind}/v${QT_TARGET_VERSION}/install")
            else()
                file(GLOB _qt_versions LIST_DIRECTORIES TRUE "C:/Qt_${_kind}/v6.*")
                list(SORT _qt_versions COMPARE NATURAL ORDER DESCENDING)
                foreach(_version IN LISTS _qt_versions)
                    list(APPEND _qt_candidates "${_version}/install")
                endforeach()
            endif()
        endif()
    endforeach()
    foreach(_root IN LISTS _qt_roots)
        if(QT_TARGET_VERSION)
            set(_qt_versions "${_root}/${QT_TARGET_VERSION}")
        else()
            file(GLOB _qt_versions LIST_DIRECTORIES TRUE "${_root}/6.*")
            list(SORT _qt_versions COMPARE NATURAL ORDER DESCENDING)
        endif()
        foreach(_version IN LISTS _qt_versions)
            if(MSVC)
                list(APPEND _qt_candidates "${_version}/msvc2022_64" "${_version}/msvc2019_64")
            elseif(MINGW)
                list(APPEND _qt_candidates "${_version}/mingw_64")
            elseif(APPLE)
                list(APPEND _qt_candidates "${_version}/macos")
            else()
                list(APPEND _qt_candidates "${_version}/gcc_64")
            endif()
        endforeach()
    endforeach()
    if(APPLE)
        list(APPEND _qt_candidates "/opt/homebrew" "/usr/local")
    endif()
    foreach(_candidate IN LISTS _qt_candidates)
        if(EXISTS "${_candidate}/lib/cmake/Qt6/Qt6Config.cmake" OR
           EXISTS "${_candidate}/lib/cmake/Qt5/Qt5Config.cmake")
            list(PREPEND CMAKE_PREFIX_PATH "${_candidate}")
            message(STATUS "Auto-selected Qt SDK: ${_candidate}")
            break()
        endif()
    endforeach()
endif()

if(Qt6_DIR)
    set(QT_VERSION_MAJOR 6)
elseif(Qt5_DIR)
    set(QT_VERSION_MAJOR 5)
else()
    find_package(QT NAMES Qt6 Qt5 REQUIRED COMPONENTS Widgets)
endif()
find_package(Qt${QT_VERSION_MAJOR} REQUIRED COMPONENTS Widgets SerialPort Network Location)
get_target_property(_qt_core_type Qt${QT_VERSION_MAJOR}::Core TYPE)
set(QT_STATIC_BUILD OFF)
if(_qt_core_type STREQUAL "STATIC_LIBRARY")
    set(QT_STATIC_BUILD ON)
endif()
if(FORCE_QT_STATIC AND NOT QT_STATIC_BUILD)
    message(FATAL_ERROR "FORCE_QT_STATIC requires a static Qt SDK. Select it with CMAKE_PREFIX_PATH or Qt6_DIR.")
endif()
message(STATUS "Qt ${Qt${QT_VERSION_MAJOR}_VERSION}: ${_qt_core_type}")

# Set before FetchContent so every dependency uses the same MSVC runtime.
# CMAKE_BUILD_TYPE is empty with Visual Studio; inspect Qt's imported configurations.
if(MSVC AND NOT DEFINED CMAKE_MSVC_RUNTIME_LIBRARY)
    get_target_property(_qt_debug_location Qt${QT_VERSION_MAJOR}::Core IMPORTED_LOCATION_DEBUG)
    get_target_property(_qt_debug_implib Qt${QT_VERSION_MAJOR}::Core IMPORTED_IMPLIB_DEBUG)
    if(_qt_debug_location OR _qt_debug_implib)
        set(_qt_debug_suffix "$<$<CONFIG:Debug>:Debug>")
    else()
        set(_qt_debug_suffix "")
        add_compile_definitions($<$<CONFIG:Debug>:_ITERATOR_DEBUG_LEVEL=0>)
        message(STATUS "Release-only Qt SDK: matching release MSVC runtime in Debug")
    endif()
    if(QT_FEATURE_static_runtime)
        set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded${_qt_debug_suffix}")
    else()
        set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded${_qt_debug_suffix}DLL")
    endif()
endif()
